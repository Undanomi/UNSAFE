# Set the same random value of at least 32 characters in both token variables.
INTERNAL_API_TOKEN=
BUILD_SERVER_TOKEN=

# Use independent random passwords for the three PostgreSQL services.
AI_POSTGRES_PASSWORD=
BUILD_POSTGRES_PASSWORD=
FRONTEND_POSTGRES_PASSWORD=

# Set this to: stat -c '%g' /dev/kvm
KVM_GID=993

# Frontend (the NEXT_PUBLIC_* values are embedded into the browser bundle at build time).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<PROJECT_ID>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<PROJECT_ID>
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_ADMIN_PROJECT_ID=<PROJECT_ID>
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Host port published by the frontend container.
FRONTEND_PORT=3000

# Maximum simultaneous machine generation sessions per user.
MAX_ACTIVE_SESSIONS_PER_USER=1
