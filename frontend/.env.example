# クライアント側で利用する Firebase API の設定
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<PROJECT_ID>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<PROJECT_ID>
NEXT_PUBLIC_FIREBASE_APP_ID=

# サーバー側で利用する Firebase Admin SDK の設定
FIREBASE_ADMIN_PROJECT_ID=<PROJECT_ID>
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# pnpm run dev 用の AI サーバーのエンドポイント
DEV_AI_SERVER_URL=http://localhost:8000

# pnpm run dev 用の PostgreSQL 設定。
# DEV_FRONTEND_POSTGRES_PASSWORD と DEV_DATABASE_URL 内のパスワードは同じ値にする。
DEV_FRONTEND_POSTGRES_PASSWORD=
DEV_FRONTEND_POSTGRES_PORT=5432
DEV_DATABASE_URL=postgresql://frontend_service:change-me@localhost:5432/frontend_service

# Docker でフロントエンドを起動する際の設定。
# FRONTEND_POSTGRES_PASSWORD は Docker 内の PostgreSQL だけに使用する。
FRONTEND_POSTGRES_PASSWORD=
FRONTEND_PORT=3000
