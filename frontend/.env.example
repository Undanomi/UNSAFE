# Docker Compose で利用する環境変数
# PostgreSQL のパスワード。他のサービスとは異なるランダムな値を設定する。
FRONTEND_POSTGRES_PASSWORD=
# ホスト側に公開するフロントエンドのポート。
FRONTEND_PORT=3000

# アプリケーションで利用する環境変数
# クライアント側で利用する Firebase API の設定
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<PROJECT_ID>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<PROJECT_ID>
NEXT_PUBLIC_FIREBASE_APP_ID=

# サーバー側で利用する Firebase Admin SDK の設定
FIREBASE_ADMIN_PROJECT_ID=<PROJECT_ID>
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"


# AIサーバーの URL
AI_SERVER_URL=http://localhost:8000

# フロントエンド用 PostgreSQL の接続 URL。ローカル開発時に使用する。
# Docker Compose 起動時は Compose がコンテナ用の接続 URL を設定する。
DATABASE_URL=postgresql://frontend_service:change-me@localhost:5432/frontend_service
