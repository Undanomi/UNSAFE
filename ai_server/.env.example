AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=65536
AI_TIMEOUT_SECONDS=600
CVE_MIN_YEAR=2024
CVE_SELECTION_ATTEMPTS=5
GITHUB_TOKEN=
DATABASE_URL=postgresql://ai_service:local-development-only@localhost:5433/ai_service
SOURCE_ROOT=./data/scenarios
BUILD_SERVER_URL=http://localhost:8080
# Docker Composeから外部build serverを使う場合だけ設定します。
# AI_BUILD_SERVER_URL=http://server:8080
BUILD_SERVER_TOKEN=local-development-token
