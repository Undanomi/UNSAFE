AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=65536
# AI_PROVIDER=openai に切り替える場合に設定します。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=65536
GENERATION_RETRIES=3
AI_TIMEOUT_SECONDS=600
BUILD_TIMEOUT_SECONDS=30
CVE_MIN_YEAR=2024
SCENARIO_GENERATION_ATTEMPTS=5
SCENARIO_CHUNK_SIZE=320
SOURCE_GENERATION_ATTEMPTS=3
SCENARIO_SYNC_ATTEMPTS=3
GITHUB_TOKEN=
# DockerイメージにはKali公式rockyou.txtを同梱します。直接起動時だけパスを変更してください。
ROCKYOU_PATH=/app/data/rockyou.txt
# 約2〜3分向け候補を選ぶ元辞書の行範囲です。
ROCKYOU_MIN_LINE=100000
ROCKYOU_MAX_LINE=200000
# Compose用。ランダムな値を設定してください。
AI_POSTGRES_PASSWORD=
# ai_serverをホストから直接起動するときの接続先です。上と同じパスワードをURLエンコードして設定します。
DATABASE_URL=postgresql://ai_service:<password>@localhost:5433/ai_service
SOURCE_ROOT=./data/scenarios
SKILLS_ENABLED=true
SKILLS_MAX_ACTIVE=32
SKILLS_MAX_PER_PHASE=8
SKILL_CONTEXT_MAX_CHARS=50000
SKILL_SELECTION_MAX_CHARS=60000
SKILL_SELECTION_RETRIES=2
SKILL_SELECTION_MAX_CVES=3
# 管理画面を使う場合は3つの認証値を必ず変更し、Composeのadminプロファイルを有効にします。
SQLADMIN_USERNAME=
SQLADMIN_PASSWORD=
SQLADMIN_SESSION_SECRET=
# HTTPS 配下の本番環境では true にします。
SQLADMIN_SECURE_COOKIES=false
BUILD_SERVER_URL=http://server:8080
BUILD_REPAIR_MAX_ATTEMPTS=3
# 生成候補ごとに最小OSコンテナを作り、provision.sh相当のruntime導入から検証します。
SOURCE_SANDBOX_ENABLED=true
SOURCE_SANDBOX_TOKEN=replace-with-at-least-32-random-characters
SOURCE_SANDBOX_EXECUTION_IMAGE=debian:13-slim
SOURCE_WORKBENCH_ACTION_LIMIT=8
SOURCE_SANDBOX_TIMEOUT_SECONDS=240
SOURCE_SANDBOX_COMMAND_TIMEOUT_SECONDS=180
SOURCE_SANDBOX_MAX_CONCURRENT=2
SOURCE_SANDBOX_QUEUE_CAPACITY=100
SOURCE_SANDBOX_SESSION_TTL_SECONDS=900
# Docker Composeから外部build serverを使う場合だけ設定します。
# AI_BUILD_SERVER_URL=http://server:8080

# build_serverのINTERNAL_API_TOKENと同じ32文字以上のランダムな値を設定してください。
BUILD_SERVER_TOKEN=local-development-token
DOWNLOAD_SIGNING_SECRET=replace-with-at-least-32-random-characters
DOWNLOAD_URL_TTL_SECONDS=1800
